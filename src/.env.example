# =============================================================================
#  Environment template — copy to `.env` and fill in. NEVER commit the real .env
#  (it is git-ignored). Dummy values here are fine.
#
#  If the watsonx.ai variables are left blank, the extraction layer automatically
#  uses the deterministic OFFLINE extractor, so the whole pipeline still runs,
#  demos, and passes tests with no credentials. The scoring/ranking engine never
#  needs any of these — it is pure, offline Python.
# =============================================================================

# --- IBM watsonx.ai (the model behind Bob's extraction step) ---
WATSONX_APIKEY=your-ibm-cloud-api-key
WATSONX_URL=https://us-south.ml.cloud.ibm.com
WATSONX_PROJECT_ID=your-watsonx-project-id
WATSONX_MODEL_ID=ibm/granite-3-8b-instruct

# --- Force the offline extractor even if credentials are set (demo/CI) ---
# Set to "1" to bypass watsonx entirely.
TRIAGE_OFFLINE=0

# --- Storage ---
# SQLite audit-log path (created automatically if missing).
TRIAGE_DB_PATH=evidence_audit.db

# --- API server ---
TRIAGE_HOST=127.0.0.1
TRIAGE_PORT=8000
